# Maintainer: Matt Barr
# AUR package for Inode, built from the tagged source. Bump pkgver, then `updpkgsums` and `makepkg --printsrcinfo > .SRCINFO`.
pkgname=inode
pkgver=0.7.0
pkgrel=1
pkgdesc='Keyboard-first, two-pane file manager for Omarchy and Hyprland'
arch=('x86_64')
url='https://github.com/matthewjaybarr-png/inode'
license=('GPL-3.0-or-later')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator')
makedepends=('rust' 'cargo' 'npm')
optdepends=('wl-clipboard: copy and paste with other apps'
            'libarchive: extract archives (bsdtar)'
            'udisks2: eject and encrypted drives'
            'ripgrep: faster search inside files'
            'gocryptfs: locked folders')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP') # shortcut: fill with updpkgsums once the v0.7.0 tag exists

build() {
  cd "$pkgname-$pkgver"
  npm ci
  npm run build -- --no-bundle
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 src-tauri/target/release/inode "$pkgdir/usr/bin/inode"
  install -Dm644 src-tauri/icons/128x128.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/inode.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/inode.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Inode
Comment=File manager
Exec=inode %U
Icon=inode
Terminal=false
Categories=System;FileTools;FileManager;Utility;
MimeType=inode/directory;
EOF
}
